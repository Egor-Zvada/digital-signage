[Unit]
Description=VVE Digital Signage maintenance
After=postgresql.service

[Service]
Type=oneshot
User=signage
Group=signage
WorkingDirectory=/opt/signage/current/apps/server
EnvironmentFile=/etc/signage/signage.env
ExecStart=/opt/signage/current/.venv/bin/python manage.py run_signage_worker --once
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/signage

