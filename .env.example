SIGNAGE_DEBUG=false
SIGNAGE_SECRET_KEY=replace-with-a-long-random-value
SIGNAGE_ALLOWED_HOSTS=signage.vve.local,192.168.110.222
SIGNAGE_CSRF_TRUSTED_ORIGINS=https://signage.vve.local
SIGNAGE_DATABASE_URL=postgresql://signage:replace-me@/signage?host=/var/run/postgresql
SIGNAGE_TIME_ZONE=Asia/Sakhalin
SIGNAGE_MEDIA_ROOT=/srv/signage/media
SIGNAGE_UPLOAD_ROOT=/srv/signage/uploads
SIGNAGE_SITE_SNAPSHOT_ROOT=/srv/signage/site-snapshots
SIGNAGE_WEATHER_LATITUDE=46.9591
SIGNAGE_WEATHER_LONGITUDE=142.7380
SIGNAGE_WEATHER_TIMEZONE=Asia/Sakhalin

